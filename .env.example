# Optional. `docker compose up` works without a .env file, using development defaults.
# To change something: cp .env.example .env

# Port published on the host for the API.
APP_PORT=3000

# Database credentials. Use only letters, numbers and dashes: they are placed in a URL.
POSTGRES_USER=smartlog
POSTGRES_PASSWORD=change-me
POSTGRES_DB=smartlog

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Only for `npm run dev`. Inside Docker, compose builds this URL from the values above.
DB_PORT=5432
DATABASE_URL=postgres://smartlog:change-me@localhost:5432/smartlog
PORT=3000
