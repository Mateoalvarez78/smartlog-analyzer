# Copy to .env for local development with `npm run dev` (docker compose up
# does not need this file: it sets these same variables itself).

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Built by docker-compose.yml from POSTGRES_* below when running in
# containers. Set it directly when running the app on the host against the
# Postgres container (see README "Desarrollo local").
DATABASE_URL=postgresql://smartlog:smartlog-dev@localhost:5432/smartlog

POSTGRES_USER=smartlog
POSTGRES_PASSWORD=smartlog-dev
POSTGRES_DB=smartlog

LOG_LEVEL=info

# Budget for GET /api/health to decide the database is unreachable.
HEALTH_DB_TIMEOUT_MS=1000

# POST /api/logs/analyze limits, see ARCHITECTURE.md section 3.
ANALYSIS_TIMEOUT_MS=5000
ANALYSIS_MAX_LOGS=100
ANALYSIS_MAX_BYTES=200000

# GET /api/logs pagination limits, see ARCHITECTURE.md section 3.
LOGS_DEFAULT_LIMIT=50
LOGS_MAX_LIMIT=500
